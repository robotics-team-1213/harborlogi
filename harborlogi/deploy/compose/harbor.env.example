# Copy outside the repository (e.g. ~/.config/harbor/harbor.env, mode 600) and point HARBOR_ENV_FILE at it.
# Never commit the filled copy. Paths, mode and the executor switch are fixed in compose.yaml.

# Web: 50+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
HARBOR_WEB_SECRET_KEY=
# The name browsers use for this host; same value as HARBOR_HOSTNAME for the proxy.
HARBOR_WEB_ALLOWED_HOSTS=

# Integrated control R only (ADR 0018). R issues the service principal and token (ADR 0015).
HARBOR_FLEET_ORIGIN=
HARBOR_FLEET_ALLOWED_ORIGINS=
HARBOR_FLEET_PRINCIPAL=
HARBOR_FLEET_TOKEN=
# R's private CA as mounted under /config, when R's certificate is not publicly trusted.
# SSL_CERT_FILE=/config/r-ca.pem

# Rosy Account sign-in (ADR 0027): the receiver file under /config, {issuer, client_id, resource, callback}.
# The callback path is /accounts/rosy/callback/. Unset keeps Harbor's local accounts only.
# HARBOR_ROSY_ACCOUNT_FILE=/config/rosy-account.json

# Set to 1 only when the deployed Fleet serves the new ARM console (docs/product-web.md).
# HARBOR_FLEET_ARM_CONSOLE_ENABLED=1
