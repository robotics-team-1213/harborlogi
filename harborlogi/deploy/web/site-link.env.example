# Installation format only. Copy into private deployment configuration.
# The installer supplies this name/port and CA through a trusted channel.
HARBOR_FLEET_ALLOWED_ORIGINS=https://site-pc.local:8443
HARBOR_FLEET_CA_FILE=/etc/harbor/site-ca.pem

# Install the Fleet-issued service token separately through secret management.
# Admin selects the approved site and enters its issued principal in the UI.
# For a deployment-managed connection instead, also set HARBOR_FLEET_ORIGIN
# and HARBOR_FLEET_PRINCIPAL. Never commit a populated installation file.
